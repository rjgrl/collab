# Proposed single-host TLS edge. Not deployed or syntax-validated with Nginx.
# Replace certificate paths/hostname; upstream must be reachable only by edge.
server {
    listen 443 ssl;
    server_name staging.example.invalid;
    ssl_certificate /etc/alumni/tls/fullchain.pem;
    ssl_certificate_key /etc/alumni/tls/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/alumni/web;
    client_max_body_size 11m;
    client_header_timeout 10s;
    client_body_timeout 30s;
    # Alternate OpenAPI transport/docs deliberately closed at the proposed
    # public edge until its API-client exposure policy is approved.
    location ^~ /api-reference { return 404; }
    location ~ ^/(api|rpc)(/|$) {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Forwarded "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_buffering off;
    }
    location / { try_files $uri $uri/ /index.html; }
}
