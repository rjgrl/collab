# PLACEHOLDERS ONLY. Documentation catalog, NOT a runnable configuration.
# Do not overwrite private environments or copy this file into a public build.
# Replace placeholders privately in the correct service/environment only.
# Production provider credentials belong in Settings > Integrations, not just env.
# See docs/operations/API_SETUP.md for supported vs proposed names.

# Runtime secrets/settings supplied by Render for this one service/environment.
NODE_ENV="<YOUR_ENVIRONMENT>"
HOST="<YOUR_APPROVED_BIND_ADDRESS>"
# Render normally supplies PORT; do not override it blindly.
PORT="<YOUR_PROVIDER_ASSIGNED_PORT>"
SERVE_WEB="<YOUR_APPROVED_SAME_ORIGIN_SERVING_FLAG>"
MONGO_URI="<YOUR_PRIVATE_TLS_MONGODB_URI_SELECTING_alumni_tracking>"
# Leave DATABASE_URL unset; if required, it must equal MONGO_URI exactly.
CORS_ORIGIN="<YOUR_EXACT_HTTPS_ORIGIN>"
APP_URL="<YOUR_SAME_EXACT_HTTPS_ORIGIN>"
UPLOAD_DIR="<YOUR_PRIVATE_PERSISTENT_UPLOAD_DIRECTORY>"
# Copied ciphertext needs original keys until coordinated re-encryption.
# Do not claim production/dev isolation while keys remain shared; review that
# migration separately. Never replace these values blindly.
SESSION_SECRET="<YOUR_EXISTING_ENVIRONMENT_SESSION_SECRET>"
MFA_ENCRYPTION_KEY="<YOUR_EXISTING_ENVIRONMENT_MFA_ENCRYPTION_KEY>"
INTEGRATION_ENCRYPTION_KEY="<YOUR_EXISTING_ENVIRONMENT_INTEGRATION_ENCRYPTION_KEY>"
# Optional encrypted backups require separately reviewed configuration.
BACKUP_ENCRYPTION_KEY="<YOUR_DISTINCT_BACKUP_ENCRYPTION_KEY>"
BACKUP_DIR="<YOUR_PRIVATE_BACKUP_DIRECTORY_OUTSIDE_UPLOADS_AND_WEB>"
MONGODB_TOOLS_DIR="<YOUR_APPROVED_MONGODB_TOOLS_DIRECTORY>"

# Provider legacy development/bootstrap names. Ignored as provider credentials
# in production: enter values through the Super Admin encrypted Settings store.
RECAPTCHA_SITE_KEY="<YOUR_ENVIRONMENT_RECAPTCHA_V2_SITE_KEY>"
RECAPTCHA_SECRET_KEY="<YOUR_ENVIRONMENT_RECAPTCHA_V2_SECRET_KEY>"
GOOGLE_CLIENT_ID="<YOUR_ENVIRONMENT_GOOGLE_WEB_OAUTH_CLIENT_ID>"
GOOGLE_CLIENT_SECRET="<YOUR_ENVIRONMENT_GOOGLE_WEB_OAUTH_CLIENT_SECRET>"
GOOGLE_SERVICE_ACCOUNT_JSON="<YOUR_DEDICATED_DRIVE_SERVICE_ACCOUNT_JSON>"
GOOGLE_DRIVE_FOLDER_ID="<YOUR_PRIVATE_SHARED_DRIVE_FOLDER_ID>"
GOOGLE_SHEETS_SPREADSHEET_ID="<YOUR_ENVIRONMENT_TARGET_SPREADSHEET_ID>"
# No separate Sheets JSON env setting is consumed. Use its OWN account field
# in Settings > Integrations; do not reuse the Drive account for strict isolation.
SMTP_URL="<YOUR_APPROVED_PUBLIC_HTTPS_JSON_EMAIL_GATEWAY_URL>"
SMTP_FROM="<YOUR_VERIFIED_ENVIRONMENT_SENDER_ADDRESS>"
EMAIL_GATEWAY_API_KEY="<YOUR_DOMAIN_RESTRICTED_SENDING_ONLY_API_KEY>"
IMAGE_HOST_PROVIDER="<YOUR_PRIVACY_APPROVED_IMAGE_HOST_PROVIDER>"
IMGBB_API_KEY="<YOUR_DEDICATED_ENVIRONMENT_PUBLIC_IMAGE_UPLOAD_KEY>"
# Forms secret is generated by the server UI and copied privately to Script Properties.
GOOGLE_FORMS_WEBHOOK_SECRET="<YOUR_SERVER_GENERATED_ENVIRONMENT_WEBHOOK_SECRET>"
# Optional range screening: local or hibp; no HIBP_API_KEY is consumed.
PASSWORD_BREACH_CHECK="<YOUR_APPROVED_LOCAL_OR_HIBP_MODE>"

# Documentation-only manual test inputs, NOT app settings. Use synthetic staging
# fixtures and a controlled, consenting recipient. Sending/write tests can cost money.
API_TEST_RECIPIENT="<YOUR_CONTROLLED_STAGING_RECIPIENT>"
SYNTHETIC_IMAGE_BASE64="<YOUR_DISPOSABLE_NONPERSONAL_IMAGE_BASE64>"
FORM_SMOKE_PAYLOAD_JSON="<YOUR_APPROVED_SCHEMA_VALID_SYNTHETIC_STAGING_PAYLOAD_JSON>"

# PROPOSED ONLY: current server consumes NONE of these SMS variables.
# A reviewed adapter and billing approval are required before SMS can work.
TWILIO_ACCOUNT_SID="<YOUR_PROPOSED_ENVIRONMENT_TWILIO_ACCOUNT_SID>"
TWILIO_API_KEY_SID="<YOUR_PROPOSED_RESTRICTED_VERIFY_API_KEY_SID>"
TWILIO_API_KEY_SECRET="<YOUR_PROPOSED_RESTRICTED_VERIFY_API_KEY_SECRET>"
TWILIO_VERIFY_SERVICE_SID="<YOUR_PROPOSED_ENVIRONMENT_VERIFY_SERVICE_SID>"
SMS_TEST_TO="<YOUR_CONTROLLED_CONSENTING_STAGING_PHONE_IN_E164>"

# Apps Script Script Properties, NOT Node application settings:
# ALUMNI_WEBHOOK_URL uses the approved environment's HTTPS webhook endpoint.
# GOOGLE_FORMS_WEBHOOK_SECRET must match the server-generated active secret.
