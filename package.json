{
  "name": "Alumni-Tracking-Ss",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "accounts:local": "tsx scripts/provision-test-accounts.ts",
    "dev:accounts": "tsx scripts/provision-test-accounts.ts --start",
    "test:completion-db": "tsx apps/server/src/completion-local.ts",
    "dev": "node scripts/local-workflow.mjs dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types && tsc --project scripts/tsconfig.json",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev",
    "dev:server": "node scripts/local-workflow.mjs dev:server",
    "db:local": "node scripts/local-workflow.mjs db:local",
    "setup:local": "node scripts/setup-local.mjs",
    "setup:dev": "node scripts/setup-local.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:clone-local": "node scripts/rehearse-clone.mjs",
    "db:seed": "node scripts/local-workflow.mjs db:seed",
    "test": "node scripts/test-local.mjs",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "test:browser": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:production-build": "node scripts/check-production-build.mjs",
    "test:security-db": "tsx scripts/security-db-check.ts",
    "test:pentest-local": "tsx apps/server/src/pentest-local.ts",
    "test:forms-db": "tsx apps/server/src/forms-local.ts",
    "test:recovery-local": "tsx scripts/rehearse-recovery.ts",
    "test:staging-local": "tsx apps/server/src/phase5-local.ts",
    "test:browser-types": "tsc --project scripts/tsconfig.browser.json",
    "check:server-build": "node scripts/check-server-build.mjs",
    "db:migrate": "node scripts/local-workflow.mjs db:migrate",
    "db:verify-transactions": "node scripts/local-workflow.mjs db:verify-transactions",
    "test:mongoose-db": "tsx scripts/mongoose-db-check.ts",
    "test:roles-local": "tsx scripts/check-local-roles.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Alumni-Tracking-Ss/config": "workspace:*",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "catalog:",
    "mongodb-memory-server-core": "11.3.0",
    "otplib": "13.5.0",
    "rolldown": "1.2.7",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
    "pnpm": "12.5.1"
  },
  "packageManager": "pnpm@12.5.1"
}
