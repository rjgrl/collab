# Runtime secrets belong in Render's environment editor, never in Git.
NODE_ENV=production
HOST=0.0.0.0
# Render supplies PORT; when absent the API defaults to 5000.
SERVE_WEB=true

# Copy the private Atlas URI and explicitly include /alumni_tracking before ?.
# URL-encode credentials. Do not leave placeholder brackets in the actual value.
MONGO_URI=
# Leave the legacy variable unset. If used, it must exactly match MONGO_URI.
DATABASE_URL=

# Use the SAME exact public HTTPS origin for these values and web VITE_SERVER_URL.
CORS_ORIGIN=https://YOUR-SERVICE.onrender.com
APP_URL=https://YOUR-SERVICE.onrender.com

# Persistent disk mount. Never expose this directory as static web content.
UPLOAD_DIR=/var/data/uploads

# Preserve the EXISTING source values when using the migrated Atlas data.
SESSION_SECRET=
MFA_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY=

# Never deploy local-only authentication/verification bypasses.
LOCAL_DISABLE_MFA=false
LOCAL_REQUIRE_EMAIL_VERIFICATION=true
LOCAL_REQUIRE_PHONE_VERIFICATION=true
ALLOW_PUBLIC_SIGNUP=false
STAFF_EMAIL_DOMAINS=buksu.edu.ph,student.buksu.edu.ph

AUTH_IP_STORE=mongodb
AUTH_IP_LIMIT=30
AUTH_IP_WINDOW_SECONDS=900
AUTH_ACCOUNT_LIMIT=5
SESSION_IDLE_MINUTES=30
PASSWORD_BREACH_CHECK=local
# Keep empty unless exact ingress proxy IPs and X-Forwarded-For overwrite policy
# have been verified. Never set Express trust proxy=true or trust arbitrary headers.
TRUSTED_PROXY_IPS=

# RELEASE BLOCKER: real SMS delivery is not implemented. /health/ready deliberately
# remains 503 until SMS and required email delivery are configured and verified.
# Configure encrypted provider credentials through Settings > Integrations.

# Optional encrypted in-app backups: set all three only when enabling backups.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=
MONGODB_TOOLS_DIR=
