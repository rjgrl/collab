NODE_ENV=development

# Local testing only; never accepted in production or with a remote database.
LOCAL_DISABLE_MFA=true

# Public signup for loopback functionality tests; production defaults to false.
ALLOW_PUBLIC_SIGNUP=true

# Explicit local testing exemptions. Unverified contacts remain unverified.
# Production refuses either false value. Remove or set true before strict testing.
LOCAL_REQUIRE_EMAIL_VERIFICATION=false
LOCAL_REQUIRE_PHONE_VERIFICATION=false

HOST=127.0.0.1

# Blank means forwarded headers are ignored. Never use wildcard/CIDR entries.
TRUSTED_PROXY_IPS=
CORS_ORIGIN=http://localhost:3001
APP_URL=http://localhost:3000
UPLOAD_DIR=./uploads
DATABASE_URL=mongodb://127.0.0.1:27018/alumni_tracking?replicaSet=rs0

# Verification-code hashing. setup:local generates a private random value.
SESSION_SECRET=
MFA_ENCRYPTION_KEY=
# Integration credentials encryption key (64 hex chars from `openssl rand -hex 32`).
# Separate from MFA_ENCRYPTION_KEY, SESSION_SECRET and BACKUP_ENCRYPTION_KEY.
# Required in production. Never stored in the database, logged or backed up.
INTEGRATION_ENCRYPTION_KEY=
# Offline common-password screening is always active; hibp opts into prefix-only HTTPS checks.
PASSWORD_BREACH_CHECK=local
# Blank: MongoDB counters in production, process memory in development.
AUTH_IP_STORE=
AUTH_IP_LIMIT=30
AUTH_IP_WINDOW_SECONDS=900
AUTH_ACCOUNT_LIMIT=5
SESSION_IDLE_MINUTES=30
HTTP_LOGGING=false
# HTTPS JSON mail gateway; enable Email in Settings > Integrations.
SMTP_URL=
SMTP_FROM=
# Development only: `pnpm db:seed` copies it into the database once. Ignored in production; manage it in Settings > Integrations.
EMAIL_GATEWAY_API_KEY=
# SMS delivery is currently a stub; no real texts are sent.

# Admin/faculty accounts must use one of these email domains (exact match, comma-separated).
# Required in production. Test domains (example.test, collab.test) must never be used in production.
STAFF_EMAIL_DOMAINS=buksu.edu.ph,student.buksu.edu.ph

# Google sign-in: OAuth client (Web application). Redirect URI: ${APP_URL}/api/auth/google/callback
# Development only: `pnpm db:seed` copies it into the database once. Ignored in production; manage it in Settings > Integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Evidence storage in Google Drive: service-account key JSON on one line, and the ID of a
# folder inside a Shared Drive the service account is a member of (service accounts have no
# storage quota of their own). Leave blank to store evidence on private local disk.
# Development only: `pnpm db:seed` copies it into the database once. Ignored in production; manage it in Settings > Integrations.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
# Alumni profile photos: imgbb | google_drive | local (blank = imgbb when a key is set).
# imgBB image URLs are PUBLIC to anyone who has the link.
# Development only: `pnpm db:seed` copies it into the database once. Ignored in production; manage it in Settings > Integrations.
IMAGE_HOST_PROVIDER=
IMGBB_API_KEY=
# Development only: `pnpm db:seed` copies it into the database once. Ignored in production; manage it in Settings > Integrations.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Backup encryption key (64 hex chars from `openssl rand -hex 32`).
# Separate from MFA_ENCRYPTION_KEY, SESSION_SECRET and INTEGRATION_ENCRYPTION_KEY.
# Required only if backups are enabled. Never stored in DB or backups.
BACKUP_ENCRYPTION_KEY=
# Directory for encrypted backup files (absolute path; must be outside UPLOAD_DIR).
# Required only if backups are enabled.
BACKUP_DIR=
# Directory containing mongodump and mongorestore binaries.
# Required only if backups are enabled.
MONGODB_TOOLS_DIR=
