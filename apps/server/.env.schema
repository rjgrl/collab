# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Strict by default. False is allowed only in local development/test with managed rs0.
# @optional @public @type=boolean
LOCAL_REQUIRE_EMAIL_VERIFICATION=true

# @optional @public @type=boolean
LOCAL_REQUIRE_PHONE_VERIFICATION=true

# Optional listen IP; blank defaults to loopback. Review public binds explicitly.
# @optional @type=string
HOST=

# @optional @public @type=boolean
ALLOW_PUBLIC_SIGNUP=false

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# @type=url
APP_URL=

# Used for verification-code hashing; configure at least 32 characters.
# @optional @type=string
SESSION_SECRET=

# Authenticator encryption key: generate 32 random bytes as 64 hex characters.
# @optional @type=string
MFA_ENCRYPTION_KEY=

# Integration credentials encryption key: generate 32 random bytes as 64 hex characters from `openssl rand -hex 32`.
# Separate from MFA_ENCRYPTION_KEY, SESSION_SECRET and BACKUP_ENCRYPTION_KEY.
# Required in production. Never stored in the database, logged or backed up.
# @optional @type=string
INTEGRATION_ENCRYPTION_KEY=

# Optional k-anonymity network screening; local dictionary is always used.
# @optional @type=enum(local,hibp)
PASSWORD_BREACH_CHECK=

# Shared MongoDB counters are the default in production; memory in development.
# @optional @type=enum(memory,mongodb)
AUTH_IP_STORE=

# @optional @type=string
AUTH_IP_LIMIT=

# @optional @type=string
AUTH_IP_WINDOW_SECONDS=

# @optional @type=string
AUTH_ACCOUNT_LIMIT=

# @optional @type=string
SESSION_IDLE_MINUTES=

# @optional @type=boolean
HTTP_LOGGING=

# Explicit managed-local-development authenticator pause; production rejects true.
# @optional @type=boolean
LOCAL_DISABLE_MFA=false

# Exact IPs of proxies allowed to overwrite X-Forwarded-For; blank trusts none.
# @optional @type=string
TRUSTED_PROXY_IPS=

# Development only: `pnpm db:seed` copies it into the database once. Ignored in production; manage it in Settings › Integrations.
# @optional @type=string
RECAPTCHA_SITE_KEY=

# Development only: `pnpm db:seed` copies it into the database once. Ignored in production; manage it in Settings › Integrations.
# @optional @type=string
RECAPTCHA_SECRET_KEY=

# Development only: `pnpm db:seed` copies it into the database once. Ignored in production; manage it in Settings › Integrations.
# @optional @type=string
GOOGLE_CLIENT_ID=

# Development only: `pnpm db:seed` copies it into the database once. Ignored in production; manage it in Settings › Integrations.
# @optional @type=string
GOOGLE_CLIENT_SECRET=

# Development only: `pnpm db:seed` copies it into the database once. Ignored in production; manage it in Settings › Integrations.
# @optional @type=string
GOOGLE_SERVICE_ACCOUNT_JSON=

# Development only: `pnpm db:seed` copies it into the database once. Ignored in production; manage it in Settings › Integrations.
# @optional @type=string
GOOGLE_DRIVE_FOLDER_ID=

# Development only: `pnpm db:seed` copies it into the database once. Ignored in production; manage it in Settings › Integrations.
# @optional @type=string
GOOGLE_SHEETS_SPREADSHEET_ID=

# Development only: `pnpm db:seed` copies it into the database once. Ignored in production; manage it in Settings › Integrations.
# @optional @type=string
GOOGLE_FORMS_WEBHOOK_SECRET=

# Development only: `pnpm db:seed` copies it into the database once. Ignored in production; manage it in Settings › Integrations.
# @optional @type=string
SMTP_URL=

# Development only: `pnpm db:seed` copies it into the database once. Ignored in production; manage it in Settings › Integrations.
# @optional @type=string
SMTP_FROM=

# Development only: `pnpm db:seed` copies it into the database once. Ignored in production; manage it in Settings › Integrations.
# @optional @type=string
IMGBB_API_KEY=

# Development only: `pnpm db:seed` copies it into the database once. Ignored in production; manage it in Settings › Integrations.
# @optional @type=string
IMAGE_HOST_PROVIDER=

# Development only: `pnpm db:seed` copies it into the database once. Ignored in production; manage it in Settings › Integrations.
# @optional @type=string
EMAIL_GATEWAY_API_KEY=

# @optional @type=string
UPLOAD_DIR=
