# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Optional listen IP; blank defaults to loopback. Review public binds explicitly.
# @optional @type=string
HOST=

# @optional @public @type=boolean
ALLOW_PUBLIC_SIGNUP=false

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# @type=url
APP_URL=

# Used for verification-code hashing; configure at least 32 characters.
# @optional @type=string
SESSION_SECRET=

# Authenticator encryption key: generate 32 random bytes as 64 hex characters.
# @optional @type=string
MFA_ENCRYPTION_KEY=

# Optional k-anonymity network screening; local dictionary is always used.
# @optional @type=enum(local,hibp)
PASSWORD_BREACH_CHECK=

# Shared MongoDB counters are the default in production; memory in development.
# @optional @type=enum(memory,mongodb)
AUTH_IP_STORE=

# @optional @type=string
AUTH_IP_LIMIT=

# @optional @type=string
AUTH_IP_WINDOW_SECONDS=

# @optional @type=string
AUTH_ACCOUNT_LIMIT=

# @optional @type=string
SESSION_IDLE_MINUTES=

# @optional @type=boolean
HTTP_LOGGING=

# Local testing only; honored exclusively when NODE_ENV=development.
# @optional @type=boolean
LOCAL_DISABLE_MFA=

# Exact IPs of proxies allowed to overwrite X-Forwarded-For; blank trusts none.
# @optional @type=string
TRUSTED_PROXY_IPS=

# @optional @type=string
RECAPTCHA_SITE_KEY=

# @optional @type=string
RECAPTCHA_SECRET_KEY=

# @optional @type=string
GOOGLE_CLIENT_ID=

# @optional @type=string
GOOGLE_CLIENT_SECRET=

# @optional @type=string
GOOGLE_SERVICE_ACCOUNT_JSON=

# @optional @type=string
GOOGLE_DRIVE_FOLDER_ID=

# @optional @type=string
GOOGLE_SHEETS_SPREADSHEET_ID=

# @optional @type=string
GOOGLE_FORMS_WEBHOOK_SECRET=

# @optional @type=string
SMTP_URL=

# @optional @type=string
SMTP_FROM=

# @optional @type=string
IMGBB_API_KEY=

# @optional @type=string
IMAGE_HOST_PROVIDER=

# @optional @type=string
UPLOAD_DIR=
